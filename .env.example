# ─── Database ─────────────────────────────────────────────────────────────────
# Vercel Postgres (via Neon) sets these automatically when you link a database.
# For local dev with Neon/Supabase/Railway, fill them in manually.

# Pooled connection URL (used by the app at runtime via PgBouncer)
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true&connect_timeout=15"

# Direct (non-pooled) connection — used by Prisma migrations and the seed script
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# ─── Data Provider ─────────────────────────────────────────────────────────────
# "mock"   → in-memory mock data, no DB required (default)
# "prisma" → queries PostgreSQL via Prisma (requires DATABASE_URL above)
# Auto-detection: if DATABASE_URL is set and this is unset, Prisma is used.
NEXT_PUBLIC_DATA_PROVIDER="mock"

# ─── Optional: ProPublica Nonprofit Explorer ───────────────────────────────────
# No API key required; set to override the default base URL.
# PROPUBLICA_API_BASE="https://projects.propublica.org/nonprofits/api/v2"
