# Database - PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/nonprofit_compare"

# Data Provider: "mock" | "propublica" | "irs"
NEXT_PUBLIC_DATA_PROVIDER="mock"

# ProPublica Nonprofit Explorer API (no key required, but set base URL)
PROPUBLICA_API_BASE="https://projects.propublica.org/nonprofits/api/v2"

# Optional: future IRS dataset path
IRS_DATASET_PATH=""
